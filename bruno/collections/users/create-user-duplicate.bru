meta {
  name: Create user with duplicate username
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/users
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Duplicate Admin",
    "username": "admin",
    "password": "somepassword",
    "role": "user"
  }
}

script:pre-request {
  if (!bru.getEnvVar("token")) {
    const res = await bru.runRequest("collections/auth/login"); 
    bru.setEnvVar("token", res.data.token);
  }
}

assert {
  res.status: 409
}