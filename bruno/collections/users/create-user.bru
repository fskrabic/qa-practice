meta {
  name: Create user (admin access required)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/users
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Dana Dev",
    "username": "danadev",
    "password": "dana1234",
    "role": "user"
  }
}

script:pre-request {
  if (!bru.getEnvVar("token")) {
    const res = await bru.runRequest("collections/auth/login"); 
    bru.setEnvVar("token", res.data.token);
  }
}