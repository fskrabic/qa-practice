meta {
  name: Delete comment
  type: http
  seq: 3
}

delete {
  url: {{baseUrl}}/api/comments/{{commentId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

script:pre-request {
  if (!bru.getEnvVar("token")) {
    const res = await bru.runRequest("collections/auth/login");
    bru.setEnvVar("token", res.data.token);
  }
}