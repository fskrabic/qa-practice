meta {
  name: Get tasks with filters
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/tasks?status=todo&priority=high&sortBy=dueDate&order=asc
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

params:query {
  status: todo
  priority: high
  sortBy: dueDate
  order: asc
}

script:pre-request {
  if (!bru.getEnvVar("token")) {
    const res = await bru.runRequest("collections/auth/login");
    bru.setEnvVar("token", res.data.token);
  }
}