meta {
  name: Get task by ID
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/tasks/1
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

script:pre-request {
  if (!bru.getEnvVar("token")) {
    const res = await bru.runRequest("collections/auth/login"); 
    bru.setEnvVar("token", res.data.token);
  }
}

assert {
  res.status: 200
}