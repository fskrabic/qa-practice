meta {
  name: Create task with validation errors
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/tasks
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "title": "",
    "status": "",
    "priority": ""
  }
}

script:pre-request {
  if (!bru.getEnvVar("token")) {
    const res = await bru.runRequest("collections/auth/login");
    bru.setEnvVar("token", res.data.token);
  }
}

assert {
  res.status: 400
}